    "baseIdle": ["sit", "lie"],
    "idle": ["sit", "lie", "music", "lying", "accordion", "autumn"],
    "ambientIdle": ["music", "lying", "accordion", "autumn"],
    "interaction": ["wave", "petted"],
    "drag": ["sit_lift_up", "lie_lift_up", "sway", "put_down"],
