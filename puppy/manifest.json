  "poseTransitions": {
    "sit": {
      "lie": "sit_to_lie"
    },
    "lie": {
      "sit": "lie_to_sit"
    }
  },
  "clickMappings": {
    "sit": ["wave"],
    "lie": ["petted"],
    "ambient": ["sit", "lie", "music", "lying", "accordion", "autumn"],
    "default": ["sit", "lie"]
