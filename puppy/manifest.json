    },
    "caterpillar_chase": {
      "label": "Caterpillar Chase",
      "status": "waiting_for_assets"
    },
    "caterpillar_catch": {
      "label": "Caterpillar Catch",
      "status": "waiting_for_assets"
    }
  }
}
